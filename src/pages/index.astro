---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import PracticeCard from '../components/PracticeCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Icon from '../components/Icon.astro';
import {areas} from '../data/content';
const experience = [
  {year:'2017 – 2021',role:'Analista Legal de Contratación Pública',institution:'Municipio de Guayaquil'},
  {year:'2022',role:'Analista de Asesoría Jurídica',institution:'Comisión de Tránsito del Ecuador'},
  {year:'2023 – 2024',role:'Jefe de Contratación Pública de Servicios y Obras',institution:'Benemérito Cuerpo de Bomberos de Guayaquil'},
  {year:'2025',role:'Director de Asesoría Legal y Patrocinio / Coordinador General de Asesoría Jurídica',institution:'Servicio Nacional de Contratación Pública · SERCOP'},
  {year:'2026',role:'Director de Coactivas',institution:'Corporación del Seguro de Depósitos · COSEDE'},
];
---
<Layout title="Gerson Cevallos Apolo | Abogado en contratación pública" description="Asesoría jurídica en contratación pública, derecho administrativo, familia y derecho constitucional. Abg. Gerson Cevallos Apolo, Quito, Ecuador.">
  <Hero title="Abg. Gerson Cevallos Apolo" eyebrow="Experto en contratación pública" image="/images/hero-inicio.webp" home />
  <section class="section" aria-labelledby="about-title"><div class="container about-grid">
    <div class="portrait-wrap"><img class="portrait" src="/images/retrato.webp" alt="Abg. Gerson Cevallos Apolo" width="900" height="1125" loading="lazy" decoding="async" /><div class="portrait-caption"><strong>Gerson Cevallos Apolo</strong><span>Derecho administrativo y contratación pública</span></div></div>
    <div class="about-copy"><p class="eyebrow"><span></span>Conóceme</p><h2 id="about-title">Experiencia pública.<br />Compromiso personal.</h2><p class="lead">Mi trayectoria en instituciones públicas y mi formación en derecho administrativo respaldan una asesoría clara, estratégica y cercana.</p>
      <div class="education">
        <div class="education-item"><span>2023</span><div><h3>Magíster en Derecho Administrativo con mención en Contratación Pública.</h3><p>Universidad de Especialidades Espíritu Santo – UEES.</p></div></div>
        <div class="education-item"><span>2021</span><div><h3>Abogado de los Juzgados y Tribunales de la República del Ecuador.</h3><p>Universidad Ecotec.</p></div></div>
      </div><a class="text-link" href="/contacto/">Conversemos sobre tu caso <Icon size={18}/></a>
    </div>
  </div></section>
  <section class="section experience" aria-labelledby="experience-title"><div class="container">
    <div class="section-heading"><div><p class="eyebrow"><span></span>Trayectoria profesional</p><h2 id="experience-title">Una visión desde la experiencia.</h2></div><span class="section-index">SECTOR PÚBLICO / ECUADOR</span></div>
    <ol class="timeline" aria-label="Trayectoria profesional, del cargo más antiguo al más reciente">{experience.map(item=><li class="timeline-item"><div class="timeline-year">{item.year}</div><h3>{item.role}</h3><p>{item.institution}</p></li>)}</ol>
  </div></section>
  <section class="section" aria-labelledby="practice-title"><div class="container"><h2 id="practice-title">Áreas de práctica</h2><div class="practice-grid">{areas.map(area=><PracticeCard {...area}/>)}</div></div></section>
  <ContactCTA />
</Layout>
